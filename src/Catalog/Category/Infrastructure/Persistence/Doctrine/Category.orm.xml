<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Catalog\Category\Domain\Category" table="catalog_categories">
        <id name="id" type="category_id" column="id" length="36" />

        <field name="title" type="category_title" column="title" length="255" />
        <field name="typeId" type="type_id" column="type_id" length="36" />
        <field name="parentId" type="category_id" column="parent_id" length="36" nullable="true" />
    </entity>

</doctrine-mapping>
