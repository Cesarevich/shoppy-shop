<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Catalog\ProductHistory\Domain\ProductHistory" table="catalog_product_history">
        <id name="id" type="string" column="id" length="36" />

        <field name="productId" type="product_id" column="product_id" length="36" />
        <field name="eventName" type="string" column="event_name" length="64" />
        <field name="occurredOn" type="string" column="occurred_on" length="40" />
        <field name="changes" type="json" column="changes" />
    </entity>

</doctrine-mapping>
