<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Catalog\Product\Domain\Product" table="catalog_products">
        <id name="id" type="product_id" column="id" length="36" />

        <field name="typeId" type="type_id" column="type_id" length="36" />
        <field name="listingStatus" column="listing_status" length="32" enum-type="App\Catalog\Product\Domain\ListingStatus" />

        <embedded name="productDetails" class="App\Catalog\Product\Domain\ProductDetails" use-column-prefix="false" />
    </entity>

</doctrine-mapping>
