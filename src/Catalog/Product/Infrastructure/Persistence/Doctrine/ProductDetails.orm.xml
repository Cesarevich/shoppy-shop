<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="App\Catalog\Product\Domain\ProductDetails">
        <field name="title" type="product_title" column="title" length="255" />
        <field name="ean" type="ean" column="ean" length="13" nullable="true" />
        <field name="description" type="product_description" column="description" nullable="true" />
        <field name="year" type="product_year" column="year" nullable="true" />

        <embedded name="dimensions" class="App\Catalog\Product\Domain\Dimensions" use-column-prefix="false" />
        <embedded name="listPrice" class="App\Catalog\Product\Domain\Money" column-prefix="list_price_" />
    </embeddable>

</doctrine-mapping>
